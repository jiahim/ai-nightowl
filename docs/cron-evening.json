{
  "id": "",
  "name": "ai-nightowl-heartbeat-evening-example",
  "enabled": false,
  "schedule": {
    "type": "cron",
    "cron": "*/20 18-23 * * *",
    "timezone": "Asia/Singapore"
  },
  "task_type": "agent",
  "request": {
    "input": [
      {
        "role": "user",
        "type": "message",
        "content": [
          {
            "type": "text",
            "text": "【ai-nightowl 开发心跳示例】读取仓库内 docs/blueprint.md、docs/PRD.md 与 docs/progress.json；只推进一个依赖已满足的 pending 子任务；运行类型检查和相关测试；如实更新 progress.json。不要发送外部通知，不要直接推送远端，不要把密钥、会话标识或机器路径写入仓库。"
          }
        ]
      }
    ]
  },
  "dispatch": {
    "type": "channel",
    "channel": "console",
    "target": {
      "user_id": "default",
      "session_id": ""
    },
    "mode": "stream",
    "silent": false,
    "meta": {}
  },
  "runtime": {
    "share_session": false,
    "max_concurrency": 1,
    "timeout_seconds": 1800,
    "misfire_grace_seconds": 600,
    "tool_safety": true
  },
  "meta": {
    "example": true
  }
}
